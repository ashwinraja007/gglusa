MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_HOST=your_remote_host_ip_or_domain
MYSQL_PORT=3306
MYSQL_DB=ggl_usa_db

# SSL Configuration (optional, uncomment and configure for SSL)
# MYSQL_SSL_CA=/path/to/your/ca.pem
# MYSQL_SSL_CERT=/path/to/your/client-cert.pem
# MYSQL_SSL_KEY=/path/to/your/client-key.pem

DATABASE_URL=mysql+aiomysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DB}?ssl_verify_cert=true